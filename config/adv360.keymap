#include<behaviors.dtsi>
#include<dt-bindings/zmk/keys.h>
#include<dt-bindings/zmk/bt.h>
#include<dt-bindings/zmk/rgb.h>
#include<dt-bindings/zmk/stp.h>
#include<dt-bindings/zmk/backlight.h>
#include<dt-bindings/zmk/pointing.h>

&mt{
   flavor = "hold-preferred";
   require-prior-idle-ms= <125>;
   tapping-term-ms = <200>;
   quick-tap-ms = <200>;
};

&lt{
   flavor = "hold-preferred";
   require-prior-idle-ms= <125>;
   tapping-term-ms = <200>;
   quick-tap-ms = <200>;
};

&mmv{
   x-input-code = <INPUT_REL_X>;
   y-input-code = <INPUT_REL_Y>;
   time-to-max-speed-ms = <300>;
   acceleration-exponent = <1>;
};

&msc{
   x-input-code = <INPUT_REL_HWHEEL>;
   y-input-code = <INPUT_REL_WHEEL>;
   time-to-max-speed-ms = <300>;
   acceleration-exponent = <0>;
};

#define SYM 1
#define KPD 2
#define FN 3
#define NAV 4
#define GAMING 5
#define SYS 6

/{
   behaviors {
     #include "macros.dtsi"
     #include "version.dtsi"

     hr: homerow {
         compatible = "zmk,behavior-hold-tap";
         #binding-cells = <2>;
         flavor = "tap-preferred";
         tapping-term-ms = <300>;
         quick-tap-ms = <200>;
         require-prior-idle-ms = <125>;
         bindings = <&kp>, <&kp>;
     };
   };

 keymap {
   compatible = "zmk,keymap";
   colemak {
       bindings = <
           &none     &kp N1     &kp N2     &kp N3      &kp N4      &kp N5    &tog GAMING                                                                                  &none  &kp N6    &kp N7      &kp N8      &kp N9       &kp N0     &none
           &kp TAB   &kp Q      &kp W      &kp F       &kp P       &kp G     &kp GRAVE                                                                                    &none  &kp K     &kp L       &kp U       &kp Y        &kp SEMI   &kp BSLH
           &kp ESC   &hr LGUI A &hr LALT R &hr LCTRL S &hr LSHFT T &lt NAV D &kp LT                      &none       &none       &none      &none                         &kp GT &lt KPD H &hr RSHFT N &hr RCTRL E &hr LALT I   &hr RGUI O &kp SQT
           &kp MINUS &kp Z      &hr RALT X &kp C       &kp V       &kp B                                             &none       &none                                           &kp J     &kp M       &kp COMMA   &hr RALT DOT &kp FSLH   &kp EQUAL
           &none     &none      &none      &kp LEFT    &kp RIGHT                          &mt LSHFT BSPC &lt SYM ESC &lt SYS DEL &lt FN TAB &lt SYM ENTER &mt RSHFT SPACE                  &kp DOWN    &kp UP      &none        &none      &none
       >;
   };

   symbol {
     bindings = <
       &none &none         &none         &none          &none     &none     &none                                    &none &none     &none     &none          &none          &none         &none
       &none &kp AT        &kp GRAVE     &kp LBKT       &kp RBKT  &kp CARET &none                                    &none &kp EXCL  &kp LT    &kp GT         &kp EQUAL      &kp COLON     &none
       &none &hr LGUI BSLH &hr LALT FSLH &hr LCTRL LBRC &kp RBRC  &kp STAR  &none      &none &none &none &none       &none &kp QMARK &kp LPAR  &hr RCTRL RPAR &hr LALT MINUS &hr RGUI SEMI &none
       &none &kp HASH      &hr RALT DLLR &kp PIPE       &kp TILDE &kp UNDER                  &none &none                   &kp PLUS  &kp PRCNT &kp DQT        &hr RALT SQT   &kp AMPS      &none
       &none &none         &none         &none          &none                    &none &none &none &none &none &none                 &none     &none          &none          &none         &none
     >;
   };

   keypad {
       bindings = <
           &none &none     &none   &none  &none  &none     &none                                            &none &none  &none     &none     &none    &none    &none
           &none &kp FSLH  &kp N7  &kp N8 &kp N9 &kp MINUS &none                                            &none &none  &none     &none     &none    &none    &none
           &none &kp COMMA &kp N4  &kp N5 &kp N6 &kp PLUS  &none          &none &none     &none &none       &none &none  &kp RSHFT &kp RCTRL &kp LALT &kp RGUI &none
           &none &kp STAR  &kp N1  &kp N2 &kp N3 &kp EQUAL                      &none     &none                   &none  &none     &none     &kp RALT &none    &none
           &none &none     &none   &none  &none                  &kp N0 &kp DOT &kp ENTER &none &none &none              &none     &none     &none    &none    &none
       >;
   };

   fn {
       bindings = <
           &none &none &none  &none  &none  &none   &none                                     &none &none  &none     &none     &none    &none    &none
           &none &none &kp F7 &kp F8 &kp F9 &kp F10 &none                                     &none &none  &none     &none     &none    &none    &none
           &none &none &kp F4 &kp F5 &kp F6 &kp F11 &none     &none &none &none &none         &none &none  &kp RSHFT &kp RCTRL &kp LALT &kp RGUI &none
           &none &none &kp F1 &kp F2 &kp F3 &kp F12                 &none &none                     &none  &none     &none     &kp RALT &none    &none
           &none &none &none  &none  &none              &none &none &none &none &none &none                &none     &none     &none    &none    &none
       >;
   };

   navigation_key {
       bindings = <
           &none &none    &none    &none     &none     &none &none                                              &none &none          &none          &none        &none           &none          &none
           &none &none    &none    &none     &none     &none &none                                              &none &kp HOME       &kp PG_DN      &kp PG_UP    &kp END         &msc SCRL_LEFT &msc SCRL_RIGHT
           &none &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none &none       &none &none &none &none                &none &kp LEFT       &kp DOWN       &kp UP       &kp RIGHT       &none          &none
           &none &none    &kp RALT &none     &none     &none                   &none &none                            &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &msc SCRL_DOWN &msc SCRL_UP
           &none &none    &none    &none     &none                 &none &none &none &mkp MB3 &mkp MB1 &mkp MB2                      &none          &none        &none           &none          &none
       >;
   };

   gaming {
       bindings = <
           &none &none &none &none &none &none &tog GAMING                                             &kp K &kp O  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5
           &none &none &none &none &none &none &none                                                   &kp L &kp P  &kp Q   &kp W   &kp E   &kp R   &kp T
           &none &none &none &none &none &none &none        &none &none  &kp ESC   &kp TAB             &kp N &kp I  &kp A   &kp S   &kp D   &kp F   &kp G
           &none &none &none &none &none &none                    &none  &kp LALT                            &kp M  &kp Y   &kp X   &kp C   &kp V   &kp B
           &none &none &none &none &none              &none &none &none  &kp LSHFT &kp LCTRL &kp SPACE              &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
       >;
   };

   mod {
       bindings = <
           &none &none &none &none &none &none &bootloader                                     &bootloader &none      &none      &none      &none &none &none
           &none &none &none &none &none &none &none                                           &none       &bt BT_CLR &bt BT_PRV &bt BT_NXT &none &none &none
           &none &none &none &none &none &none &none             &none &none &none &none       &none       &bl BL_TOG &bl BL_DEC &bl BL_INC &none &none &none
           &none &none &none &none &none &none                         &none &none                         &none      &none      &none      &none &none &none
           &none &none &none &none &none                   &none &none &none &none &none &none                        &none      &none      &none &none &none
       >;
   };

   extra1 {
     display-name = "Red";
     status = "reserved";
   };

   extra2 {
     display-name = "Purple";
     status = "reserved";
   };

   extra3 {
     display-name = "Cyan";
     status = "reserved";
   };

   extra4 {
     display-name = "Yellow";
     status = "reserved";
   };
 };
};
